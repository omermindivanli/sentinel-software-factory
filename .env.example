# Software Factory Environment Variables
# Copy to .env and fill in your values

# ==========================================
# Anthropic API (Required for Claude models)
# ==========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# GitHub Integration (for MCP GitHub server)
# ==========================================
GITHUB_TOKEN=your_github_personal_access_token

# ==========================================
# Linear Integration (for MCP Linear server)
# ==========================================
LINEAR_API_KEY=your_linear_api_key

# ==========================================
# Slack Integration (for MCP Slack server)
# ==========================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# ==========================================
# Jira Integration (for MCP Jira server)
# ==========================================
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token

# ==========================================
# PagerDuty Integration
# ==========================================
PAGERDUTY_API_KEY=your_pagerduty_api_key

# ==========================================
# Datadog Integration
# ==========================================
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# ==========================================
# Vault Integration (Optional)
# ==========================================
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=your_vault_token

# ==========================================
# Factory Settings
# ==========================================
FACTORY_ENV=development
FACTORY_DEBUG=true
FACTORY_LOG_LEVEL=INFO

# API Settings
FACTORY_API_HOST=0.0.0.0
FACTORY_API_PORT=8000

# Dashboard Settings
FACTORY_DASHBOARD_PORT=5173

# Database Paths (relative to project root)
FACTORY_DATA_DIR=.factory/data
FACTORY_WORK_DIR=.factory/work
FACTORY_LOG_DIR=.factory/logs